# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env to git — it is in .gitignore

# ─── Prefix rule ────────────────────────────────────────────────────────────
# Variables prefixed with VITE_PUBLIC_ are embedded in the browser bundle.
# Only put truly non-secret, public-facing values here.
# Never put API keys, secrets, or tokens here — they will be visible to users.
# ────────────────────────────────────────────────────────────────────────────

# ─── Cloudflare Turnstile ────────────────────────────────────────────────────
# Site key for the login page CAPTCHA widget.
# Get yours at: https://dash.cloudflare.com → Security → Turnstile
# Add allowed hostnames: localhost, *.trycloudflare.com
#
# TEST key (works on any domain, always passes — use for local/tunnel dev):
VITE_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Real key example (replace with your own from Cloudflare dashboard):
# VITE_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAB...

# ─── Backend API URL ─────────────────────────────────────────────────────────
# Leave empty for local dev — Vite proxy handles it automatically (→ localhost:8000).
# Set this if you deploy the backend at a public URL, e.g.:
# VITE_PUBLIC_API_URL=https://api.yourdomain.com
VITE_PUBLIC_API_URL=
