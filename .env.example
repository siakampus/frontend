# Copy this file to .env.local for local dev (never commit .env.local).
# For Vercel: set these in Settings > Environment Variables.
#
# IMPORTANT: Variables prefixed VITE_PUBLIC_ are embedded in the browser bundle.
# Never put secrets here — only safe, public-facing values.

# ── Backend API ───────────────────────────────────────────────────────────────
# Local dev:   http://localhost:8000
# Production:  https://ugnapi.online
VITE_PUBLIC_API_URL=http://localhost:8000
VITE_PUBLIC_BETTER_AUTH_URL=http://localhost:8000

# ── Cloudflare Turnstile ──────────────────────────────────────────────────────
# Test key (always passes, works on any domain — use for local/tunnel dev):
VITE_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Real key from https://dash.cloudflare.com → Security → Turnstile:
# VITE_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAB...
