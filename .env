# Local development environment
# This file is in .gitignore — NEVER commit it.
# See .env.example for template and documentation.

# ─── Cloudflare Turnstile ────────────────────────────────────────────────────
# Site key for the CAPTCHA widget on the login page.
# Use the TEST key below (always passes, works on any domain incl. trycloudflare.com):
VITE_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAD1v0g9CzBauIsHm
# When you have your own Cloudflare account + widget, replace with your real key:
# VITE_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAB6AdQ7RikUW15dg

# ─── Backend API URL ─────────────────────────────────────────────────────────
# Leave empty for local dev — Vite proxy handles it automatically (localhost:8000).
# Set this if you deploy the backend separately, e.g.:
# VITE_PUBLIC_API_URL=https://api.yourdomain.com
VITE_PUBLIC_API_URL="http://localhost:8000/api-docs"
BASE_URL="http://localhost:5173"